generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum CourseVisibility {
  PUBLIC
  PRIVATE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TestStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
}

enum QuestionType {
  MCQ
  NUMERIC
  SHORT
}

enum NotificationType {
  COURSE
  TEST
  DOUBT
  SOCIAL
  SYSTEM
}

enum PostReactionType {
  LIKE
  DISLIKE
}

model User {
  id              String            @id @default(cuid())
  name            String
  username        String            @unique
  email           String            @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  role            Role              @default(STUDENT)
  bio             String?
  phone           String?
  xp              Int               @default(0)
  level           Int               @default(1)
  heroTag         String            @default("Rookie Ranger")
  isApproved      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  accounts        Account[]
  sessions        Session[]
  taughtCourses   Course[]          @relation("TeacherCourses")
  enrollments     Enrollment[]
  applications    CourseApplication[]
  notes           NotesGeneration[]
  aiUsageLimits   AIUsageLimit[]
  xpLogs          XPLog[]
  badges          UserBadge[]
  streak          Streak?
  posts           Post[]
  postReactions   PostReaction[]
  comments        Comment[]
  courseMessages  CourseChatMessage[]
  doubts          Doubt[]
  doubtAnswers    DoubtAnswer[]
  votes           Vote[]
  results         Result[]
  rankings        Ranking[]
  notifications   Notification[]
  suspiciousFlags SuspiciousActivity[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id             String              @id @default(cuid())
  title          String
  slug           String              @unique
  description    String
  subject        String
  coverImage     String?
  visibility     CourseVisibility    @default(PUBLIC)
  activeTopic    String?
  teacherId      String
  teacher        User                @relation("TeacherCourses", fields: [teacherId], references: [id])
  lessons        Lesson[]
  enrollments    Enrollment[]
  applications   CourseApplication[]
  chats          CourseChat[]
  dailyQuestions DailyQuestion[]
  tests          Test[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  batchName String?
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model CourseApplication {
  id        String            @id @default(cuid())
  userId    String
  courseId  String
  note      String?
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  reviewedAt DateTime?
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  content     String
  videoUrl    String?
  materialUrl String?
  order       Int
  xpReward    Int      @default(20)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model NotesGeneration {
  id          String   @id @default(cuid())
  userId      String
  youtubeUrl  String
  videoId     String?
  shortNotes  String   @db.Text
  detailNotes String   @db.Text
  concepts    Json
  revision    Json
  questions   Json
  tokenCount  Int      @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AIUsageLimit {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  notesCount  Int      @default(0)
  doubtTokens Int      @default(0)
  override    Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model DailyQuestion {
  id        String     @id @default(cuid())
  courseId  String
  topic     String
  prompt    String
  options   Json
  answer    String
  solution  String
  date      DateTime
  xpReward  Int        @default(15)
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts  Result[]

  @@unique([courseId, date])
}

model Test {
  id          String     @id @default(cuid())
  courseId    String
  title       String
  topic       String
  status      TestStatus @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime
  durationMin Int
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   Question[]
  results     Result[]
  createdAt   DateTime   @default(now())
}

model Question {
  id          String       @id @default(cuid())
  testId      String?
  type        QuestionType @default(MCQ)
  prompt      String       @db.Text
  options     Json?
  answer      String
  explanation String       @db.Text
  marks       Int          @default(4)
  negative    Int          @default(0)
  test        Test?        @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Result {
  id              String          @id @default(cuid())
  userId          String
  testId          String?
  dailyQuestionId String?
  score           Float
  maxScore        Float
  answers         Json
  submittedAt     DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  test            Test?           @relation(fields: [testId], references: [id])
  dailyQuestion   DailyQuestion?  @relation(fields: [dailyQuestionId], references: [id])
}

model Ranking {
  id        String   @id @default(cuid())
  userId    String
  season    String
  rank      Int
  xp        Int
  percentile Float?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model XPLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  sourceId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  icon        String
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Streak {
  id        String   @id @default(cuid())
  userId    String   @unique
  current   Int      @default(0)
  best      Int      @default(0)
  lastSeen  DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id        String    @id @default(cuid())
  userId    String
  content   String    @db.Text
  studyHours Float?
  mockScore Float?
  imageUrl  String?
  likes     Int       @default(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions PostReaction[]
  comments  Comment[]
  createdAt DateTime  @default(now())
}

model PostReaction {
  id        String           @id @default(cuid())
  userId    String
  postId    String
  type      PostReactionType
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, postId])
  @@index([postId, type])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  content   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model CourseChat {
  id        String              @id @default(cuid())
  courseId  String
  title     String              @default("General")
  isLocked  Boolean             @default(false)
  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages  CourseChatMessage[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([courseId])
}

model CourseChatMessage {
  id        String     @id @default(cuid())
  chatId    String
  userId    String
  body      String     @db.Text
  imageUrl  String?
  parentId  String?
  reactions Json       @default("{}")
  isPinned  Boolean    @default(false)
  chat      CourseChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([chatId, createdAt])
  @@index([userId])
}

model Doubt {
  id          String        @id @default(cuid())
  userId      String
  subject     String
  title       String
  body        String        @db.Text
  imageUrl    String?
  aiHint      String?       @db.Text
  isResolved  Boolean       @default(false)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     DoubtAnswer[]
  createdAt   DateTime      @default(now())
}

model DoubtAnswer {
  id         String   @id @default(cuid())
  userId     String
  doubtId    String
  body       String   @db.Text
  verified   Boolean  @default(false)
  useful     Int      @default(0)
  notUseful  Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doubt      Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  votes      Vote[]
  createdAt  DateTime @default(now())
}

model Vote {
  id        String      @id @default(cuid())
  userId    String
  answerId  String
  useful    Boolean
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answer    DoubtAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, answerId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
}

model SuspiciousActivity {
  id        String   @id @default(cuid())
  userId    String
  testId    String?
  event     String
  ip        String?
  device    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
